{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/|fixtures/|.*\\.json$).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)\\.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
